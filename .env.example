# Dashboard e importador -> JT Server API -> PostgreSQL local
JT_API_URL=https://jt-api.rockettechbr.com.br
JT_API_KEY=
JT_API_TIMEOUT=120

# Cache do dashboard no Render e janela consultada no PostgreSQL
JT_API_CACHE_SECONDS=120
JT_HISTORY_DAYS=45

# Tamanho dos lotes enviados pelo importar_excel.py
JT_IMPORT_BATCH=3000

JT_TIMEZONE=America/Belem
JANELA_EVOLUCAO_DIAS=14

# Quanto MENOR, melhor. Deixe vazio enquanto a meta oficial não estiver definida.
META_SEM_MOV_3=
META_SEM_MOV_10=
META_RETIDOS_3=
META_RETIDOS_10=
